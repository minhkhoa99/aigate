{
  "name": "aigate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "web": "pnpm --filter @aigate/web dev",
    "web:build": "pnpm --filter @aigate/web build",
    "discovery": "pnpm --filter @aigate/discovery exec tsx src/cli.ts",
    "test": "pnpm --filter @aigate/discovery test",
    "lint": "eslint apps tools && depcruise --config .dependency-cruiser.cjs --output-type err apps",
    "lint:check": "node --test tools/lint/check.test.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "typescript-eslint": "^8.70.1"
  }
}
