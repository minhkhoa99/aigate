{
  "name": "aigate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @aigate/server --filter @aigate/web --parallel dev",
    "build": "pnpm --filter @aigate/web build && pnpm --filter @aigate/server build",
    "release:pack": "node tools/release/release.mjs pack",
    "release:verify": "node tools/release/release.mjs verify",
    "release:publish": "node tools/release/channel.mjs",
    "release:channel-rollback": "node tools/release/channel.mjs rollback",
    "release:channel-prune": "node tools/release/channel.mjs prune",
    "release:prune": "node tools/release/prune.mjs",
    "release:install": "node tools/release/managed.mjs install",
    "start": "pnpm --filter @aigate/server start",
    "web": "pnpm --filter @aigate/web dev",
    "web:build": "pnpm --filter @aigate/web build",
    "discovery": "pnpm --filter @aigate/discovery exec tsx src/cli.ts",
    "test": "pnpm --filter @aigate/discovery --filter @aigate/database --filter @aigate/engine --filter @aigate/server --filter @aigate/web --filter @aigate/parity test",
    "lint": "eslint apps packages tools && depcruise --config .dependency-cruiser.cjs --output-type err apps packages",
    "lint:check": "node --test tools/lint/check.test.mjs",
    "parity": "node tools/parity/src/cli.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "typescript-eslint": "^8.70.1"
  }
}
