# AIGate settings. Copy to .env (never committed) and uncomment or fill in what you need; an empty value is not the
# same as leaving a variable out, so keep unused lines commented; the server loads it at start
# (apps/server/src/env.ts). A variable already set in the environment wins over the file. Restart after a change.

# ---- Server ----
# Bind address; loopback by default because the gateway holds provider credentials.
# HOST=127.0.0.1
# PORT=20200
# Where aigate.db and secret.key live (default ~/.aigate).
# AIGATE_DATA_DIR=
# The key that seals stored provider keys and tokens; empty means secret.key in AIGATE_DATA_DIR. Losing it makes
# every stored key unreadable.
# AIGATE_SECRET_KEY=
# Sets the dashboard password on the first start only (8-128 characters).
# AIGATE_INITIAL_PASSWORD=
# true clears the dashboard password and every session at start; unset it afterwards.
# AIGATE_RESET_PASSWORD=
# Longest silence between two upstream stream chunks, in ms (1000-600000; default 300000).
# AIGATE_STREAM_IDLE_TIMEOUT_MS=
# Another file to load instead of the repository's .env (set in the environment, not in this file).
# AIGATE_ENV_FILE=

# ---- OAuth clients (docs/contracts/oauth.md) ----
# Google sign-ins act as the official client of the CLI or IDE. 9router ships these public installed-app clients in
# open-sse/providers/shared.js (GOOGLE_OAUTH_CLIENT, ANTIGRAVITY_OAUTH_CLIENT); AIGate keeps them out of its source.
# Without them, Sign in with Gemini CLI answers which variables are missing.
AIGATE_GEMINI_CLI_OAUTH_CLIENT_ID=
AIGATE_GEMINI_CLI_OAUTH_CLIENT_SECRET=
# Used by the Antigravity sign-in (SP16c2).
AIGATE_ANTIGRAVITY_OAUTH_CLIENT_ID=
AIGATE_ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# iFlow's OAuth client secret is server-only; the public client id is fixed by the provider.
AIGATE_IFLOW_OAUTH_CLIENT_SECRET=

# ---- Dev tools (read from the shell by pnpm parity / pnpm discovery, not by the server) ----
# NINEROUTER_PATH=.reference/9router
# NINEROUTER_URL=http://localhost:20128
# NINEROUTER_PASSWORD=
# OPENAI_API_KEY=
