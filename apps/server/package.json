{
  "name": "@aigate/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && pnpm run \"/dev:/\"",
    "dev:tsc": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:node": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.json && node --test test/app.test.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
